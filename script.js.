  { folder: "batik-lasem", name: "Batik Lasem" },
  { folder: "batik-megamendung", name: "Batik Mega Mendung" },
  { folder: "batik-pala", name: "Batik Pala" },
  { folder: "batik-parang", name: "Batik Parang" },
