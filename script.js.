function tampilkanGaleri() {
  if (!motifGrid) return;

  motifGrid.innerHTML = "";

  motifFolders.forEach((motif) => {
    const nomorGambar = motifImages[motif.folder] || [];

    nomorGambar.forEach((nomor, index) => {
      const imagePath = `galeri/${motif.folder}/${nomor}.jpg`;
      const card = document.createElement("article");
      card.className = "motif-card";

      const img = document.createElement("img");
      img.src = imagePath;
      img.alt = `${motif.name} nomor ${nomor}`;
      img.loading = "lazy";

      img.onerror = () => card.remove();

      const content = document.createElement("div");
      content.className = "motif-card-content";

      const title = document.createElement("h3");
      title.textContent = motif.name;

      const description = document.createElement("p");
      description.textContent = `Koleksi ${index + 1}`;

      content.append(title, description);
      card.append(img, content);
      motifGrid.appendChild(card);
    });
  });
}

tampilkanGaleri();

let currentImageUrl = null;

function clearImage() {
  if (currentImageUrl) {
    URL.revokeObjectURL(currentImageUrl);
    currentImageUrl = null;
  }

  if (imageInput) imageInput.value = "";
  if (imagePreview) imagePreview.removeAttribute("src");
  if (previewWrap) previewWrap.hidden = true;
  if (uploadZone) uploadZone.hidden = false;
  if (resultPlaceholder) resultPlaceholder.hidden = false;

  if (resultMessage) {
    resultMessage.hidden = true;
    resultMessage.textContent = "";
  }
}

if (imageInput) {
  imageInput.addEventListener("change", () => {
    const file = imageInput.files[0];
    if (!file) return;

    if (!ALLOWED_TYPES.includes(file.type)) {
      alert("Pilih gambar berformat JPG, PNG, atau WebP.");
      clearImage();
      return;
    }

    if (file.size > MAX_FILE_SIZE) {
      alert("Ukuran gambar maksimal 8 MB.");
      clearImage();
      return;
    }

    if (currentImageUrl) URL.revokeObjectURL(currentImageUrl);

    currentImageUrl = URL.createObjectURL(file);
    imagePreview.src = currentImageUrl;
    previewWrap.hidden = false;
    uploadZone.hidden = true;
    resultPlaceholder.hidden = true;

    resultMessage.hidden = false;
    resultMessage.textContent =
      "Gambar berhasil dimuat. Prediksi motif memerlukan layanan AI yang aktif.";
  });
}

if (removeImage) {
  removeImage.addEventListener("click", clearImage);
}

const menuToggle = document.getElementById("menuToggle");
const navLinks = document.getElementById("navLinks");

if (menuToggle && navLinks) {
  menuToggle.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    navLinks.classList.toggle("open", !isOpen);
  });

  navLinks.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      navLinks.classList.remove("open");
      menuToggle.setAttribute("aria-expanded", "false");
    });
  });
}

const year = document.getElementById("year");
if (year) year.textContent = new Date().getFullYear();

const galleryPrev = document.getElementById("galleryPrev");
const galleryNext = document.getElementById("galleryNext");

function geserGaleri(arah) {
  if (!motifGrid) return;

  const card = motifGrid.querySelector(".motif-card");
  if (!card) return;

  const jarak = card.getBoundingClientRect().width + 20;
  motifGrid.scrollBy({ left: arah * jarak * 2, behavior: "smooth" });
}

if (galleryPrev) {
  galleryPrev.addEventListener("click", () => geserGaleri(-1));
}

if (galleryNext) {
  galleryNext.addEventListener("click", () => geserGaleri(1));
}
